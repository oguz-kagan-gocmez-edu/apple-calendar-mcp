{
  "name": "apple-calendar-mcp",
  "displayName": "Apple Calendar for Mac",
  "version": "0.4.1",
  "description": "Read and manage the calendars and reminders on your Mac (iCloud, Google, Exchange) through EventKit: agenda, free time, conflicts, create and move events, preview and undo changes. Runs locally; unofficial, not affiliated with Apple.",
  "author": {
    "name": "Oğuz Kağan Göçmez",
    "url": "https://github.com/oguz-kagan-gocmez-edu"
  },
  "homepage": "https://github.com/oguz-kagan-gocmez-edu/apple-calendar-mcp#readme",
  "repository": "https://github.com/oguz-kagan-gocmez-edu/apple-calendar-mcp",
  "documentationUrl": "https://github.com/oguz-kagan-gocmez-edu/apple-calendar-mcp#claude-plugin",
  "supportUrl": "https://github.com/oguz-kagan-gocmez-edu/apple-calendar-mcp/issues",
  "privacyPolicyUrl": "https://github.com/oguz-kagan-gocmez-edu/apple-calendar-mcp#what-the-plugin-runs-and-sends",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "keywords": ["calendar", "macos", "eventkit", "icloud", "scheduling", "mcp"],
  "mcpServers": {
    "apple-calendar": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--quiet",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "apple-calendar-mcp"
      ]
    }
  }
}
