{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apple-calendar-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    // No id needed: on the first deploy Wrangler creates the namespace in your
    // account and binds it; later deploys keep using the same one.
    { "binding": "OAUTH_KV" }
  ],
  "ratelimits": [
    // Per-IP cap on /register and /authorize (see src/index.ts). namespace_id is
    // any number unique within your account; it is not a secret.
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "4711", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // Your time zone (IANA name). Times without an offset are read in this zone.
    "TZ": "Europe/Istanbul",
    // iCloud by default; any CalDAV server works.
    "CALDAV_URL": "https://caldav.icloud.com",
    // Calendar id or title for new events; empty means the first writable one.
    "CALDAV_DEFAULT_CALENDAR": "",
    // "1" hides create/update/delete.
    "READ_ONLY": "0"
  }
  // Secrets (never in this file): npx wrangler secret put CALDAV_USERNAME / CALDAV_PASSWORD / CONNECTOR_PASSWORD
}
