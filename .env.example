# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# --- iCloud (or any CalDAV server) -----------------------------------------
# Your Apple ID email.
CALDAV_USERNAME=you@icloud.com
# An app-specific password, NOT your Apple ID password:
# appleid.apple.com > Sign-In and Security > App-Specific Passwords.
CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: other CalDAV servers (Fastmail, Nextcloud...). Default: https://caldav.icloud.com
# CALDAV_URL=https://caldav.icloud.com
# Optional: calendar id for new events (see `doctor` output). Default: the first calendar.
# CALDAV_DEFAULT_CALENDAR=

# --- Connector ---------------------------------------------------------------
# The public https address Claude will use (no trailing /mcp).
PUBLIC_URL=https://calendar.example.com
# You type this once in the browser when connecting from claude.ai. 12+ characters.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CONNECTOR_PASSWORD=change-me-to-a-long-random-string
# Your time zone, for times without an offset ("tomorrow at 3pm").
TZ=Europe/Istanbul

# Only with docker-compose.https.yml (Caddy): the host name in PUBLIC_URL, without https://
# DOMAIN=calendar.example.com

# --- Optional ----------------------------------------------------------------
# Where OAuth data (hashed tokens) is kept. Docker uses /data.
# DATA_DIR=./data
# Extra OAuth redirect URIs to allow, comma-separated (Claude's are built in).
# OAUTH_ALLOWED_REDIRECTS=
# Allow http://localhost redirects (the MCP Inspector). Default: on only when
# PUBLIC_URL is itself localhost; keep it off on a public server.
# OAUTH_ALLOW_LOCALHOST=0
# Which proxies may set X-Forwarded-For (the login rate limit uses it). The Docker
# image trusts any, because only your proxy can reach the 127.0.0.1-bound port.
# FORWARDED_ALLOW_IPS=127.0.0.1
